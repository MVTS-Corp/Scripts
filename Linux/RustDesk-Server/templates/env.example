# .env.example - RustDesk server settings. Template v1.1.0 (2026-11-14).
# install-rustdesk-server.sh writes the real .env (mode 600, root owned)
# next to compose.yaml. Never commit a real .env.

# Exact release tag, at least 14 days old. "latest" is rejected.
RD_VERSION=CHANGE-ME-exact-release-tag

# Image digest for that tag (multi-arch index digest, sha256:...). The
# installer records it on first install if not given; pass --digest to
# pin it up front.
RD_DIGEST=sha256:CHANGE-ME

# Public DNS name clients use for the ID and relay server.
# DNS only (not proxied): the ports are raw TCP and UDP.
RD_RELAY_HOST=CHANGE-ME.example.com

# Optional hbbr bandwidth limits in Mb/s. Leave unset for the built-in
# defaults. The installer keeps these lines when it rewrites .env.
#TOTAL_BANDWIDTH=1024
#SINGLE_BANDWIDTH=128
#LIMIT_SPEED=32

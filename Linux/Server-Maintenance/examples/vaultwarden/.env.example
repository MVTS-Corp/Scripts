# Copy to /opt/Vaultwarden/.env, chmod 600, root-owned. Never commit .env.
# The image version is pinned in compose.yaml, not here.
DOMAIN=https://vault.example.com
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true
PASSWORD_HINTS_ALLOWED=false
SHOW_PASSWORD_HINT=false
IP_HEADER=CF-Connecting-IP
LOG_LEVEL=warn
# Argon2 PHC string from: docker run --rm -it vaultwarden/server:<tag> /vaultwarden hash
# Single-quote it; it contains $ characters.
ADMIN_TOKEN='CHANGE-ME'
